# docker/.env 模板 —— 复制为 .env 后填入真实值，.env 已在 .gitignore 中
#
#   cp .env.example .env && chmod 600 .env
#
# ⚠️ .env 含明文口令，绝不能提交。chmod 600 是为了避免同机其他用户读到。

# Grafana admin 密码（compose 中用了 ${GRAFANA_PASSWORD:?...}，缺失会直接拒绝启动）
GRAFANA_PASSWORD=change-me

# 可选：覆盖镜像 tag（默认 aigc-comfyui:2.6.0-cu124）
# COMFYUI_IMAGE=aigc-comfyui:2.6.0-cu124
