{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "核心指标。连续满载时若爬到 80°C+ 且 SM 频率同步下降，即温度墙（阶段二降速假设的验证依据）",
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 0,
          "max": 90,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "red", "value": 85 }
            ]
          },
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        { "expr": "DCGM_FI_DEV_GPU_TEMP", "legendFormat": "GPU 温度", "refId": "A" },
        { "expr": "DCGM_FI_DEV_MEMORY_TEMP", "legendFormat": "HBM 温度", "refId": "B" }
      ],
      "title": "GPU 温度 (°C) — 80/85 为阈值线",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "P100 boost 上限约 1329 MHz。满载时掉到 1100 以下 = 降频",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1400,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": null }
            ]
          },
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": {
        "legend": { "calcs": ["last", "min"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        { "expr": "DCGM_FI_DEV_SM_CLOCK", "legendFormat": "SM 频率 (MHz)", "refId": "A" }
      ],
      "title": "SM 频率 (MHz) — 上限 1329",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 9 },
      "id": 3,
      "options": {
        "legend": { "calcs": ["last", "mean"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        { "expr": "DCGM_FI_DEV_GPU_UTIL", "legendFormat": "GPU 利用率", "refId": "A" },
        { "expr": "DCGM_FI_DEV_MEM_COPY_UTIL", "legendFormat": "显存带宽占用", "refId": "B" }
      ],
      "title": "利用率 (%)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "P100 PCIe 上限 250 W。长期贴着上限跑 = 可能触发功耗墙",
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "min": 0,
          "max": 260,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 220 },
              { "color": "red", "value": 245 }
            ]
          },
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 9 },
      "id": 4,
      "options": {
        "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        { "expr": "DCGM_FI_DEV_POWER_USAGE", "legendFormat": "功耗 (W)", "refId": "A" }
      ],
      "title": "功耗 (W) — 上限 250",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "mbytes",
          "min": 0,
          "max": 16384,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 13926 },
              { "color": "red", "value": 15565 }
            ]
          },
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 9 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        { "expr": "DCGM_FI_DEV_FB_USED", "legendFormat": "显存占用 (MB)", "refId": "A" }
      ],
      "title": "显存占用 (MB / 16384)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "XID 是 GPU 硬件/驱动级错误，出现任何非零值都值得立刻查。PCIe replay 增长说明链路有问题（透传环境重点盯）",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["last", "sum"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        { "expr": "increase(DCGM_FI_DEV_XID_ERRORS[5m])", "legendFormat": "XID 错误增量 / 5m", "refId": "A" },
        { "expr": "increase(DCGM_FI_DEV_PCIE_REPLAY_COUNTER[5m])", "legendFormat": "PCIe replay 增量 / 5m", "refId": "B" }
      ],
      "title": "健康指标 — 出现非零即告警",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["p100", "gpu", "aigc"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timezone": "browser",
  "title": "P100-实时观测",
  "uid": "p100-live",
  "version": 1
