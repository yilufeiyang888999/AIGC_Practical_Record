# 环境变量样例（根目录）—— 复制为 .env 后填真实值
#
#   cp .env.example .env
#
# ⚠️ .env 已在 .gitignore 中，绝不要提交真实密钥。

# ── aigc-gateway ────────────────────────────────────────────────
# 留空 = 关闭鉴权（仅本地开发；启动时会打警告日志）
AIGC_API_KEY=dev

# 后端地址（算力端走 SSH 隧道时填本地转发端口）
COMFY_HOST=http://127.0.0.1:8288
LLM_HOST=http://127.0.0.1:8000

# 网关监听：只绑回环，外部访问走 SSH 隧道（ComfyUI/Grafana 同理）
AIGC_HOST=127.0.0.1
AIGC_PORT=8300

# 工作流模板 / 输出目录
AIGC_WORKFLOW=workflows/lora_workflow_api.json
AIGC_OUTPUT=output

# 单任务超时（秒）。P100 大分辨率 + 温度墙场景要留足
AIGC_TASK_TIMEOUT=600

# GPU 准入控制（09-20 OOM 实测后新增）
AIGC_MIN_FREE_VRAM_GB=2.6
AIGC_VRAM_WAIT_S=120

# 保留策略（2026-09-23 新增，防止长期运行 OOM / 撑爆磁盘）
AIGC_TASK_TTL_S=86400          # 内存任务记录保留 24h
AIGC_RESULT_TTL_S=604800       # 结果文件保留 7 天
AIGC_CLEANUP_INTERVAL_S=3600   # 清理周期 1h

# ── docker 编排 ─────────────────────────────────────────────────
# Grafana 密码（也可放 docker/.env，见 docker/.env.example）
GRAFANA_PASSWORD=change-me
